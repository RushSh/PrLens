# Copy to .env and fill in. Never commit .env.

# Baseten: Muse Spark Open, the model that scores regions (open weights)
BASETEN_API_KEY=
BASETEN_API_BASE=https://inference.baseten.co/v1
PRLENS_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
# Prices for cost estimates (US$ per million tokens); check your Baseten dashboard
# BASETEN_PRICE_IN=1.25
# BASETEN_PRICE_OUT=4.25

# Meta Model API (OpenAI-compatible): Muse Spark and Muse Wonder as alternative scorers
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
PRLENS_SPARK_MODEL=muse-spark-1.3
PRLENS_WONDER_MODEL=muse-wonder-1.0
# Reasoning effort for the Meta API and Baseten models. Keep low to control output-token cost.
PRLENS_REASONING_EFFORT=low

# Muse Glimmer served locally with MLX (start it with: mlx_lm.server --model <id> --port 8080)
GLIMMER_API_BASE=http://localhost:8080/v1
PRLENS_GLIMMER_MODEL=mlx-community/Muse-Glimmer-30B-4bit
PRLENS_LOCAL_MAX_TOKENS=12000

# Muse Glimmer 30B (BF16) on a Fireworks on-demand deployment (1 x H200, ~$8/h while running).
# Create it with infra/fireworks_glimmer.sh up, then paste the printed deployment here.
FIREWORKS_API_KEY=
FIREWORKS_GLIMMER_MODEL=
FIREWORKS_REASONING_EFFORT=
FIREWORKS_MAX_TOKENS=24000

# GitHub: optional for public PRs; needed for private repos or higher rate limits (prlens triage-pr)
# GITHUB_TOKEN=
