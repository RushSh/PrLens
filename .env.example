# Copy to .env and fill in. Never commit .env.

# Meta Model API (OpenAI-compatible)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Model IDs: confirm exact IDs in the Meta Model API model list and fix these if they differ.
PRLENS_SPARK_MODEL=muse-spark-1.3
PRLENS_WONDER_MODEL=muse-wonder-1.0

# Baseten (Muse Spark Open, open weights). Optional until credits arrive.
BASETEN_API_KEY=
BASETEN_API_BASE=https://inference.baseten.co/v1  # confirm in Baseten quickstart
PRLENS_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# Muse Glimmer served locally with MLX (start it with: mlx_lm.server --model <id> --port 8080)
GLIMMER_API_BASE=http://localhost:8080/v1
PRLENS_GLIMMER_MODEL=mlx-community/Muse-Glimmer-30B-4bit
PRLENS_LOCAL_MAX_TOKENS=12000

# Muse Glimmer 30B (BF16) on a Fireworks on-demand deployment (1 x H200, ~$8/h while running).
# Create it with scripts/fireworks_glimmer.sh up, then paste the printed deployment here.
FIREWORKS_API_KEY=
FIREWORKS_GLIMMER_MODEL=
# Leave empty for the model default (comparable with local Glimmer runs); or low / medium / high
FIREWORKS_REASONING_EFFORT=
# Reply budget per review on Fireworks (reasoning included)
FIREWORKS_MAX_TOKENS=24000

# Dashboard: when set, every finished run is also saved to the dashboard database (see web/README.md)
# PRLENS_API_URL=http://127.0.0.1:4000

# Reasoning effort for review passes. Keep low to control output-token cost.
PRLENS_REASONING_EFFORT=low

# Comma-separated reviewer panel (names in config.py: spark, wonder, glimmer, glimmer_fw, spark_open).
# Default panel: Spark (hosted) + Glimmer (local, no credits). Use Wonder only for escalations.
PRLENS_PANEL=spark,glimmer
