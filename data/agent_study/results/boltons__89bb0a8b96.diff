+def test_singularize():
+    # plurals in -es lose the -es
+    assert strutils.singularize('classes') == 'class'
+    assert strutils.singularize('buses') == 'bus'
+    assert strutils.singularize('wishes') == 'wish'
+    assert strutils.singularize('churches') == 'church'
+    assert strutils.singularize('boxes') == 'box'
+    # ordinary -s plurals still lose just the -s
+    assert strutils.singularize('chances') == 'chance'
+    assert strutils.singularize('friends') == 'friend'
+    # case is preserved
+    assert strutils.singularize('Classes') == 'Class'
+    assert strutils.singularize('WISHES') == 'WISH'
+    # round-trips with pluralize
+    assert strutils.singularize(strutils.pluralize('class')) == 'class'
+    assert strutils.singularize(strutils.pluralize('wish')) == 'wish'
+
