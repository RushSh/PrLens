 })
+
+describe("#1298: revoked Map/Set drafts throw on reads", () => {
+	const {produce} = new Immer({autoFreeze: true})
+	const isProd = process.env.NODE_ENV === "production"
+	const revokedError = isProd
+		? "[Immer] minified error nr: 3. Full error at: https://bit.ly/3cXEKWf"
+		: "[Immer] Cannot use a proxy that has been revoked"
+
+	test("Map draft reads throw after produce returns", () => {
+		let draft
+		let emptyDraft
+		produce({map: new Map([["a", 1]]), empty: new Map()}, d => {
+			draft = d.map
+			emptyDraft = d.empty
+		})
+		expect(() => draft.has("a")).toThrowError(revokedError)
+		expect(() => draft.size).toThrowError(revokedError)
+		expect(() => draft.keys()).toThrowError(revokedError)
+		expect(() => draft.values()).toThrowError(revokedError)
+		expect(() => draft.entries()).toThrowError(revokedError)
+		expect(() => draft.forEach(() => {})).toThrowError(revokedError)
+		// forEach on an empty map never reached `get`, so it silently returned
+		expect(() => emptyDraft.forEach(() => {})).toThrowError(revokedError)
+		// Already threw before the fix, kept for parity
+		expect(() => draft.get("a")).toThrowError(revokedError)
+	})
+
+	test("Set draft size throws after produce returns", () => {
+		let draft
+		produce({set: new Set(["a"])}, d => {
+			draft = d.set
+		})
+		expect(() => draft.size).toThrowError(revokedError)
+		// Already threw before the fix, kept for parity
+		expect(() => draft.has("a")).toThrowError(revokedError)
+	})
+})
