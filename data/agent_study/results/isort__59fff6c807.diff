+def test_config_root(capsys, tmpdir):
+    config_file = tmpdir.join(".isort.cfg")
+    config_file.write(
+        """
+[settings]
+profile=hug
+"""
+    )
+    main.main(["--config-root", str(tmpdir), "--show-config"])
+    out, error = capsys.readouterr()
+    returned_config = json.loads(out)
+    assert returned_config["profile"] == "hug"
+    assert returned_config["config_root"] == os.path.abspath(str(tmpdir))
+    assert not error
+
+    with pytest.raises(InvalidSettingsPath):
+        main.main(
+            ["--config-root", "/random-root-folder-that-cant-exist-right?", "--show-config"]
+        )
+
+
+def test_resolve_all_configs_with_config_root(tmpdir):
+    from isort import settings
+
+    settings.find_all_configs.cache_clear()
+    settings._find_config.cache_clear()
+    settings._get_config_data.cache_clear()
+
+    dir1 = tmpdir.mkdir("subdir1")
+    dir1.join(".isort.cfg").write("[settings]\nforce_single_line=true\n")
+    file1 = dir1.join("file1.py")
+    file1.write("from foo import b, a\n")
+
+    dir2 = tmpdir.mkdir("subdir2")
+    dir2.join(".isort.cfg").write("[settings]\nforce_single_line=false\n")
+    file2 = dir2.join("file2.py")
+    file2.write("from foo import b, a\n")
+
+    main.main([str(tmpdir), "--resolve-all-configs", "--config-root", str(tmpdir)])
+
+    assert "from foo import a\nfrom foo import b" in file1.read()
+    assert "from foo import a, b" in file2.read()
+
