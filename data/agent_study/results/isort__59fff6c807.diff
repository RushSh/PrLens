+def test_find_all_configs_with_single_path(tmpdir):
+    isort_cfg = """
+[settings]
+profile=black
+"""
+    subdir = tmpdir / "subdir"
+    subdir.mkdir()
+    isort_cfg_file = subdir / ".isort.cfg"
+    isort_cfg_file.write_text(isort_cfg, "utf-8")
+
+    settings.find_all_configs.cache_clear()
+    settings._get_config_data.cache_clear()
+    config_trie = settings.find_all_configs(str(tmpdir))
+
+    config_info = config_trie.search(str(subdir / "test.py"))
+    assert config_info[0] == str(isort_cfg_file)
+    assert "profile" in config_info[1] and config_info[1]["profile"] == "black"
+
+
+def test_config_root(tmpdir):
+    config_file = tmpdir.join(".isort.cfg")
+    config_file.write_text(
+        """
+[settings]
+profile=hug
+verbose=true
+""",
+        "utf8",
+    )
+    nested = tmpdir.mkdir("nested")
+
+    settings._find_config.cache_clear()
+    settings._get_config_data.cache_clear()
+    config = Config(config_root=str(tmpdir))
+    assert config.profile == "hug"
+    assert config.verbose is True
+
+    # config_root is used even when the cwd would not find the config
+    settings._find_config.cache_clear()
+    settings._get_config_data.cache_clear()
+    config_from_nested = Config(config_root=str(nested.join("..")))
+    assert config_from_nested.profile == "hug"
+
+
+def test_invalid_config_root():
+    with pytest.raises(exceptions.InvalidSettingsPath):
+        Config(config_root="this_couldnt_possibly_actually_exists/could_it")
