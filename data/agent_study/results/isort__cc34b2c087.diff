+def test_main_stdin_check_only(capsys):
+    # Correctly sorted stdin should pass check without exiting
+    sorted_input = TextIOWrapper(BytesIO(b"import a\nimport b\n"))
+    main.main(["-", "--check"], stdin=sorted_input)
+    out, error = capsys.readouterr()
+    assert out == ""
+    assert "ERROR" not in error
+
+    # Incorrectly sorted stdin should fail check with a non-zero exit
+    unsorted_input = TextIOWrapper(BytesIO(b"import b\nimport a\n"))
+    with pytest.raises(SystemExit) as exc_info:
+        main.main(["-", "--check"], stdin=unsorted_input)
+    assert exc_info.value.code == 1
+    out, error = capsys.readouterr()
+    assert out == ""
+    assert "ERROR" in error
+
+    # Check with diff should show the diff and still fail check
+    unsorted_input = TextIOWrapper(BytesIO(b"import b\nimport a\n"))
+    with pytest.raises(SystemExit) as exc_info:
+        main.main(["-", "--check", "--diff"], stdin=unsorted_input)
+    assert exc_info.value.code == 1
+    out, error = capsys.readouterr()
+    assert "import a" in out
+    assert "import b" in out
+
+
