@@ -242,6 +242,31 @@ class TestMiscCases(TestCase):
         result = mistune.markdown("**b**")
         self.assertEqual(result, expected)
 
+    def test_markdown_func_with_list_plugins(self):
+        text = "| a |\n| --- |\n| b |\n"
+        result = mistune.markdown(text, plugins=["table"])
+        self.assertIn("<table>", result)
+        # list and tuple forms share the same normalized cache entry
+        self.assertEqual(result, mistune.markdown(text, plugins=("table",)))
+
+    def test_markdown_func_isolates_plugins_arg(self):
+        text = "| a |\n| --- |\n| b |\n"
+        plugins = ["table"]
+        first = mistune.markdown(text, plugins=plugins)
+        plugins.append("footnotes")
+        second = mistune.markdown(text, plugins=["table"])
+        self.assertEqual(first, second)
+        # other plugin sets are unaffected by the cached entry
+        self.assertNotIn("<table>", mistune.markdown(text))
+
+    def test_markdown_func_isolates_custom_renderer(self):
+        renderer = mistune.HTMLRenderer()
+        first = mistune.markdown("<b>x</b>", escape=True, renderer=renderer)
+        mistune.markdown("<b>x</b>", escape=False, renderer=renderer)
+        second = mistune.markdown("<b>x</b>", escape=True, renderer=renderer)
+        self.assertEqual(first, second)
+        self.assertIn("&lt;b&gt;", first)
+
     def test_ast_output(self):
