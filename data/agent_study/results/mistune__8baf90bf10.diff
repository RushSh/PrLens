-__cached_parsers: Dict[Tuple[bool, Optional[RendererRef], Optional[Iterable[Any]]], Markdown] = {}
+__cached_parsers: Dict[Tuple[bool, Optional[str], Optional[Tuple[Any, ...]]], Markdown] = {}
 
 
 def markdown(
@@ -75,11 +75,34 @@ def markdown(
     if renderer == "ast":
         # explicit and more similar to 2.x's API
         renderer = None
-    key = (escape, renderer, plugins)
+    # Custom renderer instances are caller-owned mutable objects; using them
+    # as cache keys would share one instance across cache entries and let
+    # later calls (or caller mutations) change earlier entries. Bypass the
+    # cache so each call gets a parser honoring the current arguments.
+    if renderer is not None and not isinstance(renderer, str):
+        md = create_markdown(escape=escape, renderer=renderer, plugins=plugins)
+        return md(text)
+
+    # Normalize the plugins iterable into an immutable tuple so the cache
+    # key is hashable and later caller mutations cannot affect it.
+    plugins_key: Optional[Tuple[Any, ...]] = None
+    if plugins is not None:
+        try:
+            plugins_key = tuple(plugins)
+        except TypeError:
+            md = create_markdown(escape=escape, renderer=renderer, plugins=plugins)
+            return md(text)
+        try:
+            hash(plugins_key)
+        except TypeError:
+            md = create_markdown(escape=escape, renderer=renderer, plugins=plugins_key)
+            return md(text)
+
+    key = (escape, renderer, plugins_key)
     if key in __cached_parsers:
         return __cached_parsers[key](text)
 
-    md = create_markdown(escape=escape, renderer=renderer, plugins=plugins)
+    md = create_markdown(escape=escape, renderer=renderer, plugins=plugins_key)
     # improve the speed for markdown parser creation
     __cached_parsers[key] = md
     return md(text)
diff --git a/tests/test_misc.py b/tests/test_misc.py
index 918d579..3cb3303 100644
--- a/tests/test_misc.py
