+
+    def test_write_pajek_with_spaces(self):
+        G=Graph()
+        G.name='test with spaces'
+        G.add_node('node with space')
+        G.add_node('another node')
+        G.add_edge('node with space','another node')
+        G.node['node with space']['attr']='value with space'
+        G['node with space']['another node']['label']='edge with space'
+        lines=list(generate_pajek(G))
+        text='\n'.join(lines)
+        assert '"test with spaces"' in text
+        assert '"node with space"' in text
+        assert '"another node"' in text
+        assert '"value with space"' in text
+        assert '"edge with space"' in text
+        H=parse_pajek(text)
+        assert_equal(sorted(H.nodes()),sorted(G.nodes()))
+        assert_equal(H.name,G.name)
+        assert_equal(H.node['node with space'].get('attr'),'value with space')
