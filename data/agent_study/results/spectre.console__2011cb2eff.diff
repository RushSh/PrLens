diff --git a/test/Spectre.Console.Tests/Unit/TextPromptTests.cs b/test/Spectre.Console.Tests/Unit/TextPromptTests.cs
index 1f28fad..f6955d1 100644
--- a/test/Spectre.Console.Tests/Unit/TextPromptTests.cs
