@@ -218,5 +218,52 @@ namespace Spectre.Console.Tests.Unit
             // Then
             return Verifier.Verify(console.Output);
         }
+
+        [Fact]
+        public void Should_Not_Append_Suffix_If_No_Choices_Or_Default_Value_Is_Specified()
+        {
+            // Given
+            var console = new TestConsole();
+            console.Input.PushTextWithEnter("John");
+
+            // When
+            console.Prompt(new TextPrompt<string>("What's your name"));
+
+            // Then
+            console.Output.NormalizeLineEndings().ShouldBe("What's your name John\n");
+        }
+
+        [Fact]
+        public void Should_Append_Suffix_If_Choices_Are_Specified()
+        {
+            // Given
+            var console = new TestConsole();
+            console.Input.PushTextWithEnter("Banana");
+
+            // When
+            console.Prompt(
+                new TextPrompt<string>("Favorite fruit")
+                    .AddChoice("Banana")
+                    .AddChoice("Orange"));
+
+            // Then
+            console.Output.NormalizeLineEndings().ShouldBe("Favorite fruit [Banana/Orange]: Banana\n");
+        }
+
+        [Fact]
+        public void Should_Append_Suffix_If_Default_Value_Is_Specified()
+        {
+            // Given
+            var console = new TestConsole();
+            console.Input.PushKey(ConsoleKey.Enter);
+
+            // When
+            console.Prompt(
+                new TextPrompt<string>("Favorite fruit")
+                    .DefaultValue("Banana"));
+
+            // Then
+            console.Output.NormalizeLineEndings().ShouldBe("Favorite fruit (Banana): Banana\n");
+        }
     }
