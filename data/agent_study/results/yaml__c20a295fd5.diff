diff --git a/tests/doc/errors.js b/tests/doc/errors.js
index 702bc87..f624c44 100644
--- a/tests/doc/errors.js
+++ b/tests/doc/errors.js
@@ -377,3 +377,54 @@ describe('Invalid plain first characters', () => {
       expect(doc.errors).toMatchObject([{ code: 'BAD_SCALAR_START' }])
     })
 })
+
+describe('do not throw during composition (eemeli/yaml#367)', () => {
+  test('error token as document value', () => {
+    const composer = new YAML.Composer()
+    const docToken = {
+      type: 'document',
+      offset: 0,
+      start: [],
+      value: {
+        type: 'error',
+        offset: 0,
+        source: 'foo',
+        message: 'Not a YAML token'
+      }
+    }
+    let docs
+    expect(() => {
+      docs = Array.from(composer.compose([docToken]))
+    }).not.toThrow()
+    expect(docs).toHaveLength(1)
+    expect(docs[0].errors).not.toHaveLength(0)
+  })
+
+  test('invalid unicode escape', () => {
+    let doc
+    expect(() => {
+      doc = YAML.parseDocument('"\\U00110000"', { prettyErrors: false })
+    }).not.toThrow()
+    expect(doc.errors).toMatchObject([{ code: 'BAD_DQ_ESCAPE' }])
+  })
+
+  test('throwing collection tag', () => {
+    const customTags = [
+      {
+        tag: '!throw',
+        collection: 'map',
+        resolve() {
+          throw new Error('fail')
+        }
+      }
+    ]
+    let doc
+    expect(() => {
+      doc = YAML.parseDocument('!throw { a: b }', {
+        customTags,
+        prettyErrors: false
+      })
+    }).not.toThrow()
+    expect(doc.errors).toMatchObject([{ code: 'TAG_RESOLVE_FAILED' }])
+  })
+})
