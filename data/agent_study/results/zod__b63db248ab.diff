@@ -617,3 +617,23 @@ test("resolves a recursive reference once, however it is written", () => {
   expect(getterCalls).toBe(1);
   expect(lazyCalls).toBe(1);
 });
+
+test("reports a shared invalid node once per path", () => {
+  const Node: any = z.object({
+    name: z.string(),
+    get child() {
+      return Node.optional();
+    },
+  });
+  const Parent = z.object({ left: Node, right: Node });
+
+  const shared = { name: 123 };
+  for (const jitless of [false, true]) {
+    const result = Parent.safeParse({ left: shared, right: shared }, { jitless });
+    expect(result.success, `jitless: ${jitless}`).toBe(false);
+    expect(result.error!.issues.map((iss) => iss.path), `jitless: ${jitless}`).toEqual([
+      ["left", "name"],
+      ["right", "name"],
+    ]);
+  }
+});
