+def test_sort_stream_with_sort_reexports_and_non_seekable_output() -> None:
+    """Ensure sort_stream works with non-seekable output streams when sort_reexports is enabled.
+
+    See https://github.com/PyCQA/isort/issues/2393
+    """
+
+    class NonSeekableOutputStream(StringIO):
+        def seekable(self) -> bool:
+            return False
+
+        def seek(self, *args, **kwargs):  # type: ignore[override]
+            raise io.UnsupportedOperation("Stream is not seekable")
+
+    input_stream = StringIO("__all__ = ('foo', 'bar')\n")
+    output_stream = NonSeekableOutputStream()
+    assert api.sort_stream(
+        input_stream, output_stream, config=Config(sort_reexports=True)
+    )
+    assert output_stream.getvalue() == "__all__ = ('bar', 'foo')\n"
+
+
+def test_sort_stream_with_sort_reexports_and_seekable_file_output(tmpdir) -> None:
+    """Seekable TextIOWrapper output must not be corrupted by the reexport rewind.
+
+    core.process() rewinds via seek(tell() - len(line)), but tell/seek on files
+    use opaque byte offsets, so multi-byte characters misplace the rewind.
+    Buffering must keep the rewind on a character-offset stream.
+    """
+    out_path = str(tmpdir.join("out.py"))
+    with open(out_path, "w+", encoding="utf-8", newline="") as output_stream:
+        assert output_stream.seekable()
+        assert api.sort_stream(
+            StringIO("__all__ = ('föö', 'bär')\n"),
+            output_stream,
+            config=Config(sort_reexports=True),
+        )
+        output_stream.seek(0)
+        assert output_stream.read() == "__all__ = ('bär', 'föö')\n"
+
+
+def test_check_stream_with_sort_reexports() -> None:
+    """check_stream must not crash when sort_reexports is enabled.
+
+    check_stream sorts into a non-storing output stream, which cannot support
+    the seek-back-and-truncate rewind that reexport sorting performs.
+    """
+    assert not api.check_stream(
+        StringIO("__all__ = ('foo', 'bar')\n"), config=Config(sort_reexports=True)
+    )
+    assert api.check_stream(
+        StringIO("__all__ = ('bar', 'foo')\n"), config=Config(sort_reexports=True)
+    )
