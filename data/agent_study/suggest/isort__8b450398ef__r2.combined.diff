+def test_sort_stream_with_sort_reexports_and_non_seekable_output() -> None:
+    """Ensure sort_stream works with non-seekable output streams when sort_reexports is enabled.
+
+    See https://github.com/PyCQA/isort/issues/2393
+    """
+
+    class NonSeekableOutputStream(StringIO):
+        def seekable(self) -> bool:
+            return False
+
+        def seek(self, *args, **kwargs):  # type: ignore[override]
+            raise io.UnsupportedOperation("Stream is not seekable")
+
+    input_stream = StringIO("__all__ = ('foo', 'bar')\n")
+    output_stream = NonSeekableOutputStream()
+    assert api.sort_stream(
+        input_stream, output_stream, config=Config(sort_reexports=True)
+    )
+    assert output_stream.getvalue() == "__all__ = ('bar', 'foo')\n"
+
+
+def test_sort_stream_atomic_buffered_output_with_cython_syntax_errors() -> None:
+    """Atomic mode must copy full content, not empty output, to buffered streams.
+
+    With atomic=True, Cython syntax errors are ignored, but the internal buffer
+    was left positioned at the end after the syntax check, so copying it to a
+    non-seekable output stream (buffered via sort_reexports) wrote empty output.
+    """
+
+    class NonSeekableOutputStream(StringIO):
+        def seekable(self) -> bool:
+            return False
+
+        def seek(self, *args, **kwargs):  # type: ignore[override]
+            raise io.UnsupportedOperation("Stream is not seekable")
+
+    test_input = "from b import d, c\nfrom a import f, e\nwhile True print 'Hello world'"
+    expected = "from a import e, f\nfrom b import c, d\n\nwhile True print 'Hello world'\n"
+    input_stream = StringIO(test_input)
+    output_stream = NonSeekableOutputStream()
+    assert api.sort_stream(
+        input_stream,
+        output_stream,
+        extension="pyx",
+        config=Config(atomic=True, sort_reexports=True),
+    )
+    assert output_stream.getvalue() == expected
