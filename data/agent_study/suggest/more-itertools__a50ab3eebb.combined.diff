diff --git a/more_itertools/more.py b/more_itertools/more.py
index 158f3b3..b35b22a 100755
--- a/more_itertools/more.py
+++ b/more_itertools/more.py
@@ -2616,6 +2616,42 @@ class seekable:
         self._cache.append(item)
         return item
 
+    def __bool__(self):
+        try:
+            self.peek()
+        except StopIteration:
+            return False
+        return True
+
+    def peek(self, default=_marker):
+        """Return the item that will be next returned from ``next()``.
+
+        Return ``default`` if there are no items left. If ``default`` is not
+        provided, raise ``StopIteration``.
+
+        """
+        if self._index is not None:
+            try:
+                return self._cache[self._index]
+            except IndexError:
+                self._index = None
+
+        try:
+            item = next(self._source)
+        except StopIteration:
+            if default is _marker:
+                raise
+            return default
+
+        self._cache.append(item)
+        if len(self._cache) == 0:
+            # maxlen=0: the cache can't hold the peeked item, so push it
+            # back onto the source to avoid consuming it.
+            self._source = chain([item], self._source)
+            return item
+        self._index = len(self._cache) - 1
+        return item
+
     def elements(self):
         return SequenceView(self._cache)
 
