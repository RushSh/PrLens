diff --git a/tests/test_more.py b/tests/test_more.py
index 4885826..df4d64f 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -3121,6 +3121,59 @@ class SeekableTest(TestCase):
         self.assertEqual(list(s), iterable)
         self.assertEqual(list(s.elements()), [])
 
+    def test_peek(self):
+        iterable = [str(n) for n in range(10)]
+
+        s = mi.seekable(iterable)
+        self.assertEqual(s.peek(), '0')  # Peeking doesn't advance
+        self.assertEqual(s.peek(), '0')  # Peeking again gives the same item
+        self.assertEqual(next(s), '0')
+        self.assertEqual(s.peek(), '1')
+        self.assertEqual(next(s), '1')
+
+        s.seek(5)
+        self.assertEqual(s.peek(), '5')  # Peeking respects the seek position
+        self.assertEqual(next(s), '5')
+
+    def test_peek_default(self):
+        s = mi.seekable([])
+        self.assertEqual(s.peek('hi'), 'hi')
+        with self.assertRaises(StopIteration):
+            s.peek()
+
+        iterable = [str(n) for n in range(3)]
+        s = mi.seekable(iterable)
+        self.assertEqual(list(s), iterable)  # Exhaust the iterable
+        self.assertEqual(s.peek('hi'), 'hi')
+        with self.assertRaises(StopIteration):
+            s.peek()
+
+        s.seek(0)  # Peeking works again after seeking back
+        self.assertEqual(s.peek(), '0')
+
+    def test_bool(self):
+        s = mi.seekable([])
+        self.assertFalse(s)
+
+        s = mi.seekable(range(3))
+        self.assertTrue(s)
+
+        iterable = [str(n) for n in range(3)]
+        s = mi.seekable(iterable)
+        self.assertEqual(list(s), iterable)  # Exhaust the iterable
+        self.assertFalse(s)
+
+        s.seek(0)
+        self.assertTrue(s)
+
+    def test_peek_maxlen_zero(self):
+        s = mi.seekable([str(n) for n in range(3)], maxlen=0)
+        self.assertEqual(s.peek(), '0')
+        self.assertEqual(s.peek(), '0')
+        self.assertEqual(next(s), '0')
+        self.assertTrue(s)
+        self.assertEqual(next(s), '1')
+
 
