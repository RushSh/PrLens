+# Simple versions are digits and dots only, e.g. "1.2.3". This is the common
+# case, so we fast-path it to avoid the expensive regex.
+_SIMPLE_VERSION_INDICATORS = frozenset("0123456789.")
+
 
 def _validate_epoch(value: object, /) -> int:
     epoch = value or 0
@@ -375,6 +379,20 @@ class Version(_BaseVersion):
             If the ``version`` does not conform to PEP 440 in any way then this
             exception will be raised.
         """
+        # Fast path for simple versions (digits and dots only), e.g. "1.2.3".
+        if version and all(c in _SIMPLE_VERSION_INDICATORS for c in version):
+            try:
+                self._release = tuple(map(int, version.split(".")))
+            except ValueError:
+                raise InvalidVersion(f"Invalid version: {version!r}") from None
+            self._epoch = 0
+            self._pre = None
+            self._post = None
+            self._dev = None
+            self._local = None
+            self._key_cache = None
+            return
+
         # Validate the version and parse it into pieces
