+    def test_non_str_version_raises_type_error(self) -> None:
+        # Fast path must not intercept non-str inputs.
+        with pytest.raises(TypeError):
+            Version(["1", ".", "0"])  # type: ignore[arg-type]
+
+    def test_fast_path_preserves_int_conversion_error(self) -> None:
+        # int() digit-limit errors must not be masked as InvalidVersion.
+        if sys.version_info < (3, 11):
+            pytest.skip("int digit limit requires Python 3.11+")
+        old_limit = sys.get_int_max_str_digits()
+        sys.set_int_max_str_digits(1000)
+        try:
+            with pytest.raises(ValueError) as exc_info:
+                Version("9" * 1500)
+            assert type(exc_info.value) is ValueError
+        finally:
+            sys.set_int_max_str_digits(old_limit)
+
