# Postgres (your local install). Create the database once:  createdb bugcensus
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bugcensus
DB_USER=postgres
DB_PASSWORD=
# node-pg-migrate uses DATABASE_URL; it must point at the same database as DB_* (see DATABASE.md)
DATABASE_URL=postgres://postgres:@localhost:5432/bugcensus

# API server (listens on this machine only)
PORT=4000
HOST=127.0.0.1

# Python side. Defaults: the repo two folders up, and its .venv
# BUGCENSUS_ROOT=/Users/you/Desktop/Repos/BugCensus
# BUGCENSUS_PYTHON=/Users/you/Desktop/Repos/BugCensus/.venv/bin/python
