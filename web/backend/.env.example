# Postgres (your local install). Create the database once:  createdb prlens
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prlens
DB_USER=postgres
DB_PASSWORD=
# node-pg-migrate uses DATABASE_URL; it must point at the same database as DB_* (see DATABASE.md)
DATABASE_URL=postgres://postgres:@localhost:5432/prlens

# API server (listens on this machine only)
PORT=4000
HOST=127.0.0.1

# Python side. Defaults: the repo two folders up, and its .venv
# PRLENS_ROOT=/Users/you/Desktop/Repos/PR Lens
# PRLENS_PYTHON=/Users/you/Desktop/Repos/PR Lens/.venv/bin/python
